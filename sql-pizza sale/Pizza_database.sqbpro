<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="Pizza_database.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1587"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Pizza_sales" custom_title="0" dock_id="1" table="4,11:mainPizza_sales"/><dock_state state="000000ff00000000fd00000001000000020000043c000002b4fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000043c0000015c00ffffff0000043c0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Pizza_sales" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="54"/><column index="2" value="55"/><column index="3" value="117"/><column index="4" value="55"/><column index="5" value="85"/><column index="6" value="156"/><column index="7" value="65"/><column index="8" value="69"/><column index="9" value="65"/><column index="10" value="92"/><column index="11" value="300"/><column index="12" value="300"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">SELECT * FROM pizza_sales;
alter table Pizza_sales drop column field1;

-- filter the data based on pizza size M
select * from Pizza_sales where pizza_size=&quot;M&quot;;

-- kpi revenue 
-- total revenue
select sum(total_price) as total_revenue  from Pizza_sales;
-- total sales
select sum(quantity) as total_sales  from Pizza_sales;
-- total ORDER
select count( DISTINCT order_id) as total_order  from Pizza_sales;

-- 03/09/2026
-- avg pizza per order 
SELECT SUM(quantity)/COUNT(DISTINCT order_id) AS avg_pizza_per_order FROM Pizza_sales;

-- avg revenue per order 
SELECT sum(total_price)/COUNT(DISTINCT order_id) AS avg_revenue_per_order FROM Pizza_sales;

-- CAST() -- is used to convert a values from one data type to other data type
-- syntax -- CAST(values as data_type)

-- example
select round(CAST(100.3456 as real),2);
select round(100.3456,2);

SELECT ROUND(SUM(total_price) / COUNT(DISTINCT order_id), 2) AS avg_revenue_per_order FROM Pizza_sales;

--business analysis

-- find the quantity sold inneach pizza category 
SELECT pizza_category,sum(quantity) from Pizza_sales group by pizza_category;

-- total revenue in each category
SELECT pizza_category,sum(total_price) from Pizza_sales group by pizza_category;

-- total order in each category
SELECT pizza_category,COUNT(DISTINCT order_id) from Pizza_sales group by pizza_category;

-- total order in each size
SELECT pizza_size,COUNT(DISTINCT order_id) from Pizza_sales group by pizza_size;

--


























-- 07-09-2026
-- usig window function
-- find avergae total price of all pizza and display with all pizza records
SELECT *,AVG(total_price) OVER () AS avg_total_price FROM Pizza_sales;

-- find the total sales revenue and display it along with every pizza record 
SELECT *,sum(total_price) OVER () AS total_sales FROM Pizza_sales;

--find maximum  unit price amoung all pizza and display it along with every pizza record
SELECT *,max(total_price) OVER () AS max_total_price FROM Pizza_sales;

-- find average total price for each pizza category  and display it for every Pizza
select *,avg(total_price) over( partition by pizza_category) as avg_total_price from Pizza_sales;

-- find the total revenue for each pizza category and display it for every Pizza
select *,sum(total_price) over( partition by pizza_category) as avg_revenue from Pizza_sales;

-- find the number of pizza records for each pizza size and display it fro every Pizza
select *,count(order_id) over(partition by pizza_size) as no_of_pizza from Pizza_sales;

-- assing a unique row number to every pizza based on total pizza from highest to lower
select *,row_number() over(order by total_price DESC) as row_no from Pizza_sales;

-- rank all pizza based on total price from highest to lowest
select * ,rank()over(order by total_price DESC) as rank from Pizza_sales;

-- assign a dense rank to all pizza based on total price from highest to lowest
select * ,dense_rank()over(order by total_price DESC) as rank from Pizza_sales;

-- rank pizzas based on total pizza within each pizza category
select *,rank() over( partition by pizza_category order by total_price DESC) as total_price_rank from Pizza_sales;

-- find the highest- priced pizza in each category
SELECT pizza_name_id, pizza_category, total_price FROM (SELECT pizza_name_id, pizza_category, total_price,
 RANK() OVER (PARTITION BY pizza_category ORDER BY total_price DESC) AS rnk FROM Pizza_sales) AS ranked_pizzas WHERE rnk = 1;

-- find the top 2 high  the highest- priced pizza in each category
SELECT pizza_name_id, pizza_category, total_price FROM (SELECT pizza_name_id, pizza_category, total_price,
 RANK() OVER (PARTITION BY pizza_category ORDER BY total_price DESC) AS rnk FROM Pizza_sales) AS ranked_pizzas WHERE rnk =2 ;
 
--  Display each pizza's total price along with the previous pizza's total price
SELECT *, LAG(total_price) OVER(ORDER BY total_price) AS previous_price FROM Pizza_sales;

--  Find the difference between the current pizza's total price and the previous pizza's total price
SELECT *, total_price - LAG(total_price) OVER(ORDER BY total_price) AS price_difference FROM Pizza_sales;

--  Display each pizza's unit price along with the previous pizza's unit price
SELECT *, LAG(unit_price) OVER(ORDER BY unit_price) AS previous_unit_price FROM Pizza_sales;

--  Display each pizza's total price along with the next pizza's total price
SELECT *, LEAD(total_price) OVER(ORDER BY total_price) AS next_price FROM Pizza_sales;

--  Find the difference between the current pizza's total price and the next pizza's total price
SELECT *, total_price - LEAD(total_price) OVER(ORDER BY total_price) AS price_difference FROM Pizza_sales;

--  Display each pizza's total price along with the previous pizza's total price
SELECT *, LAG(total_price) OVER(ORDER BY total_price) AS previous_price FROM Pizza_sales;

-- Find the difference between the current pizza's total price and the previous pizza's total price
SELECT *, total_price - LAG(total_price) OVER(ORDER BY total_price) AS price_difference FROM Pizza_sales;

-- Display each pizza's unit price along with the previous pizza's unit price
SELECT *, LAG(unit_price) OVER(ORDER BY unit_price) AS previous_unit_price FROM Pizza_sales;

-- Display each pizza's total price along with the next pizza's total price
SELECT *, LEAD(total_price) OVER(ORDER BY total_price) AS next_price FROM Pizza_sales;

-- Find the difference between the current pizza's total price and the next pizza's total price
SELECT *, total_price - LEAD(total_price) OVER(ORDER BY total_price) AS price_difference FROM Pizza_sales;

--  Display each pizza's unit price along with the next pizza's unit price
SELECT *, LEAD(unit_price) OVER(ORDER BY unit_price) AS next_unit_price FROM Pizza_sales;
 </sql><current_tab id="0"/></tab_sql></sqlb_project>
